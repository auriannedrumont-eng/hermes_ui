+                          conversationId: id,
+                          variant: t.variant,
+                          content: t.content ?? "",
+                          reasoning: t.reasoning ?? "",
+                          status: t.status ?? null,
+                          toolEvents: t.toolEvents ?? [],
+                        },
+                      },
+                { reopen: true }
