+    res = await fetch(`${endpoint.base}/messages`, { redirect: "error",
+      method: "POST",
+      headers: {
+        "Content-Type": "application/json",
+        ...(endpoint.auth === "x-api-key" && secret ? { "x-api-key": secret } : {}),
+        ...(endpoint.extraHeaders ?? {}),
+      },
