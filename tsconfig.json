{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    "mini-services",
    "examples",
    // tools/ : cache du bun portable installé par le lanceur (gitignoré).
    // Il contient les types bun « ts7.1 » pour le compilateur natif —
    // syntaxe que le TypeScript du projet ne parse pas : next build
    // échouait chez l'utilisateur (TS1005 en rafale) tant que ce dossier
    // n'était pas exclu du type-check. Absent du dépôt, le défaut ne se
    // voyait qu'à la première reconstruction locale.
    "tools",
    // hermes-agent/ : la copie fraîche de l'agent Hermes clonée par le
    // lanceur DANS le dossier de l'interface (§9 (63), gitignoré). C'est un
    // dépôt séparé avec ses propres sources (web/, evals/, website/…) qui
    // ne compilent PAS avec nos réglages : sans exclusion, next build
    // avalait tout le dépôt (507 Ko d'erreurs TS2307 en rafale) et
    // l'interface retombait en mode développement. L'agent vit chez nous,
    // il ne fait pas partie de notre build — loi (66).
    "hermes-agent"
  ]
}
