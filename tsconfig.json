{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    "mini-services",
    "examples",
    // tools/ : cache du bun portable installé par le lanceur (gitignoré).
    // Il contient les types bun « ts7.1 » pour le compilateur natif —
    // syntaxe que le TypeScript du projet ne parse pas : next build
    // échouait chez l'utilisateur (TS1005 en rafale) tant que ce dossier
    // n'était pas exclu du type-check. Absent du dépôt, le défaut ne se
    // voyait qu'à la première reconstruction locale.
    "tools"
  ]
}
